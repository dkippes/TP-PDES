# Copiá este archivo como k8s/secrets.env (git lo ignora) y elegí los valores.
# JWT_SECRET necesita al menos 32 caracteres.
# Las claves de las bases se fijan al crear el volumen: si las cambiás después,
# borrá el namespace para que las bases se creen de nuevo.
POSTGRES_PASSWORD=<clave-de-la-base-del-backend>
FLYING_POSTGRES_PASSWORD=<clave-de-la-base-de-vuelos>
JWT_SECRET=<clave-para-firmar-tokens-de-32-caracteres-o-mas>
